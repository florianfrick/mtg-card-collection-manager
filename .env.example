# Copy to .env and edit. `docker compose` reads this file automatically.
# Everything here is optional — the defaults below match the app's own.

# Host port to publish on (the container always listens on 3000).
MTG_PORT=3000

# Who may get an identity. Set both to false on a public deployment that only
# you should reach, then create your account from the login page... which needs
# sign-ups on. Order: leave sign-up on, create the account, then turn it off.
MTG_ALLOW_GUESTS=true
MTG_ALLOW_SIGNUP=true

# Set true when served over HTTPS (directly or behind a TLS proxy), so the
# session cookie gets the Secure flag.
MTG_SECURE_COOKIES=false

# How long a signed-in session lasts.
MTG_SESSION_DAYS=30
